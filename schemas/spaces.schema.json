{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "spatial-canvas.spaces.v1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "registry_revision": {
      "type": "string",
      "minLength": 1
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "resource_id",
          "revision",
          "sha256"
        ]
      }
    },
    "frame": {
      "type": "object",
      "properties": {
        "coordinate_frame": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "meter",
            "millimeter",
            "centimeter"
          ]
        },
        "up_axis": {
          "type": "string",
          "enum": [
            "X",
            "Y",
            "Z"
          ]
        }
      },
      "required": [
        "coordinate_frame",
        "unit",
        "up_axis"
      ]
    },
    "source_context": {
      "type": "object",
      "properties": {
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resource_id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "semantic_capability": {
                "type": "string",
                "enum": [
                  "explicit_regions",
                  "candidate_regions",
                  "geometry_only",
                  "none"
                ]
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "resource_id",
              "type",
              "revision",
              "sha256",
              "locator",
              "semantic_capability",
              "diagnostics"
            ]
          }
        }
      },
      "required": [
        "sources"
      ]
    },
    "spaces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "space_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "semantic_type": {
            "type": "string",
            "minLength": 1
          },
          "level_id": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "polygon_prism"
              },
              "polygon": {
                "minItems": 3,
                "type": "array",
                "items": {
                  "type": "array",
                  "items": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "additionalItems": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "z_min": {
                "type": "number"
              },
              "z_max": {
                "type": "number"
              },
              "coordinate_frame": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "default": "meter",
                "type": "string",
                "enum": [
                  "meter",
                  "millimeter",
                  "centimeter"
                ]
              }
            },
            "required": [
              "type",
              "polygon",
              "z_min",
              "z_max",
              "coordinate_frame"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "imported",
                  "derived_from_cad",
                  "derived_from_freecad",
                  "inferred_from_geometry",
                  "user_authored"
                ]
              },
              "source_resource_id": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "method",
              "source_resource_id",
              "source_revision",
              "source_sha256",
              "evidence"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "verification": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "verified"
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "state",
                  "reviewer",
                  "timestamp",
                  "note"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "candidate"
                  }
                },
                "required": [
                  "state"
                ]
              }
            ]
          }
        },
        "required": [
          "space_id",
          "name",
          "semantic_type",
          "level_id",
          "region",
          "provenance",
          "confidence",
          "verification"
        ]
      }
    }
  },
  "required": [
    "schema",
    "registry_id",
    "registry_revision",
    "design_id",
    "applies_to",
    "frame",
    "source_context",
    "spaces"
  ],
  "$id": "urn:spatial-canvas:spaces:v1"
}
