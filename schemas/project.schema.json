{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "spatial-canvas.project.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "semantic_capability": {
            "type": "string",
            "enum": [
              "explicit_regions",
              "candidate_regions",
              "geometry_only",
              "none"
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "resource_id",
          "type",
          "revision",
          "sha256",
          "locator",
          "semantic_capability",
          "diagnostics"
        ]
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "polygon_prism"
              },
              "polygon": {
                "minItems": 3,
                "type": "array",
                "items": {
                  "type": "array",
                  "items": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "additionalItems": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "z_min": {
                "type": "number"
              },
              "z_max": {
                "type": "number"
              },
              "coordinate_frame": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "default": "meter",
                "type": "string",
                "enum": [
                  "meter",
                  "millimeter",
                  "centimeter"
                ]
              }
            },
            "required": [
              "type",
              "polygon",
              "z_min",
              "z_max",
              "coordinate_frame"
            ]
          }
        },
        "required": [
          "level_id",
          "name",
          "coverage"
        ]
      }
    },
    "frame": {
      "type": "object",
      "properties": {
        "coordinate_frame": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "meter",
            "millimeter",
            "centimeter"
          ]
        },
        "up_axis": {
          "type": "string",
          "enum": [
            "X",
            "Y",
            "Z"
          ]
        }
      },
      "required": [
        "coordinate_frame",
        "unit",
        "up_axis"
      ]
    }
  },
  "required": [
    "schema",
    "project_id",
    "design_id",
    "sources",
    "levels",
    "frame"
  ],
  "$id": "urn:spatial-canvas:project:v1"
}
