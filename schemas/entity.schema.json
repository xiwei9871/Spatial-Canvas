      "type": "string",
      "minLength": 1
    },
    "native_object_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_type": {
      "type": "string",
      "minLength": 1
    },
    "room_id": {
      "type": "string",
      "minLength": 1
    },
    "source_resource_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
