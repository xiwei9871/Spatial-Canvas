{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "enum": [
        "meter",
        "centimeter",
        "millimeter",
        "scene_unit"
      ]
    },
    "up_axis": {
      "type": "string",
      "enum": [
        "X",
        "Y",
        "Z"
      ]
    },
    "meters_per_unit": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "frame_id",
    "unit",
    "up_axis",
    "meters_per_unit"
  ],
  "$id": "urn:spatial-canvas:source-frame:v1"
}
