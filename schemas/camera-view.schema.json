{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "position": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 4,
      "maxItems": 4
    },
    "projection_matrix": {
      "minItems": 16,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "orbit_target": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 3,
      "maxItems": 3
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "pixel_ratio"
      ]
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "const": "meter"
    },
    "up_axis": {
      "type": "string",
      "const": "Y"
    }
  },
  "required": [
    "position",
    "quaternion",
    "projection_matrix",
    "orbit_target",
    "viewport",
    "frame_id",
    "unit",
    "up_axis"
  ],
  "$id": "urn:spatial-canvas:camera-view:v1"
}
