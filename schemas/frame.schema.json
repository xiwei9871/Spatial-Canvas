{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "coordinate_frame": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "enum": [
        "meter",
        "millimeter",
        "centimeter"
      ]
    },
    "up_axis": {
      "type": "string",
      "enum": [
        "X",
        "Y",
        "Z"
      ]
    }
  },
  "required": [
    "coordinate_frame",
    "unit",
    "up_axis"
  ],
  "$id": "urn:spatial-canvas:frame:v1"
}
