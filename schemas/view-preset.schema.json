{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "spatial-canvas.view-preset.v1"
    },
    "preset_id": {
      "type": "string",
      "minLength": 1
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "source_resource_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "object",
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "registry_revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "registry_id",
        "registry_revision",
        "sha256",
        "locator"
      ]
    },
    "preview_uri": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.png$"
    },
    "near": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "far": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "projection": {
      "type": "string",
      "const": "perspective"
    },
    "fov_degrees": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 180
    },
    "position": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 4,
      "maxItems": 4
    },
    "orbit_target": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 3,
      "maxItems": 3
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "pixel_ratio"
      ]
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "const": "meter"
    },
    "up_axis": {
      "type": "string",
      "const": "Y"
    },
    "source_camera": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 3,
          "maxItems": 3
        },
        "quaternion": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 4,
          "maxItems": 4
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "const": "meter"
        },
        "up_axis": {
          "type": "string",
          "const": "Z"
        }
      },
      "required": [
        "position",
        "quaternion",
        "frame_id",
        "unit",
        "up_axis"
      ]
    },
    "hidden_entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ghost_entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "preset_id",
    "design_id",
    "source_resource_id",
    "source_revision",
    "source_sha256",
    "projection",
    "fov_degrees",
    "position",
    "quaternion",
    "orbit_target",
    "viewport",
    "frame_id",
    "unit",
    "up_axis",
    "source_camera",
    "hidden_entity_ids",
    "ghost_entity_ids"
  ],
  "$id": "urn:spatial-canvas:view-preset:v1"
}
