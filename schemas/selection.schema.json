{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "spatial-canvas.selection.v1"
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "replace",
        "add",
        "remove",
        "clear"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "pointer",
        "list",
        "keyboard",
        "reload"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "design_id",
    "resource_id",
    "source_revision",
    "entity_ids",
    "mode",
    "source",
    "timestamp"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "clear"
          }
        }
      },
      "then": {
        "properties": {
          "entity_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$id": "urn:spatial-canvas:selection:v1"
}
