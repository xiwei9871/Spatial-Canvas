{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "resolution": {
      "type": "string",
      "enum": [
        "exact",
        "ambiguous",
        "unresolved",
        "unavailable"
      ]
    },
    "containing_spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "space_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "semantic_type": {
            "type": "string",
            "minLength": 1
          },
          "level_id": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "verified"
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "state",
                  "reviewer",
                  "timestamp",
                  "note"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "candidate"
                  }
                },
                "required": [
                  "state"
                ]
              }
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "imported",
                  "derived_from_cad",
                  "derived_from_freecad",
                  "inferred_from_geometry",
                  "user_authored"
                ]
              },
              "source_resource_id": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "method",
              "source_resource_id",
              "source_revision",
              "source_sha256",
              "evidence"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "space_id",
          "name",
          "semantic_type",
          "level_id",
          "verification",
          "provenance",
          "confidence"
        ]
      }
    },
    "primary_space_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "point": {
      "anyOf": [
        {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "null"
        }
      ]
    },
    "frame_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "up_axis": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "X",
            "Y",
            "Z"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "readiness": {
      "type": "string",
      "enum": [
        "READY",
        "PARTIAL",
        "BLOCKED_FOR_SPATIAL_CONTEXT"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registry": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "registry_id": {
              "type": "string",
              "minLength": 1
            },
            "registry_revision": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "registry_id",
            "registry_revision",
            "sha256",
            "locator"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_status": {
      "type": "object",
      "properties": {
        "relationship_status": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "spatial-canvas.relationship-status.v1"
            },
            "component_hierarchy": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "READY",
                    "PARTIAL",
                    "BLOCKED",
                    "NOT_REQUESTED"
                  ]
                },
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "status",
                "diagnostics"
              ]
            },
            "physical_connectivity": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "READY",
                    "PARTIAL",
                    "BLOCKED",
                    "NOT_REQUESTED"
                  ]
                },
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "status",
                "diagnostics"
              ]
            },
            "space_adjacency": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "READY",
                    "PARTIAL",
                    "BLOCKED",
                    "NOT_REQUESTED"
                  ]
                },
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "status",
                "diagnostics"
              ]
            },
            "transition_graph": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "READY",
                    "PARTIAL",
                    "BLOCKED",
                    "NOT_REQUESTED"
                  ]
                },
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "status",
                "diagnostics"
              ]
            }
          },
          "required": [
            "schema",
            "component_hierarchy",
            "physical_connectivity",
            "space_adjacency",
            "transition_graph"
          ]
        },
        "schema": {
          "type": "string",
          "const": "spatial-canvas.semantic-status.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "design_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "READY",
            "PARTIAL",
            "BLOCKED_FOR_SPATIAL_CONTEXT"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resource_id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "semantic_capability": {
                "type": "string",
                "enum": [
                  "explicit_regions",
                  "candidate_regions",
                  "geometry_only",
                  "none"
                ]
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "resource_id",
              "type",
              "revision",
              "sha256",
              "locator",
              "semantic_capability",
              "diagnostics"
            ]
          }
        },
        "known_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "covered_levels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "uncovered_levels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "uncovered_volume": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "covered_levels",
            "uncovered_levels",
            "uncovered_volume"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message",
              "action"
            ]
          }
        },
        "registry_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "registry_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "project_id",
        "design_id",
        "status",
        "sources",
        "known_levels",
        "coverage",
        "diagnostics",
        "registry_id",
        "registry_revision"
      ]
    }
  },
  "required": [
    "resolution",
    "containing_spaces",
    "primary_space_id",
    "point",
    "frame_id",
    "unit",
    "up_axis",
    "readiness",
    "diagnostics",
    "registry"
  ],
  "$id": "urn:spatial-canvas:spatial-context:v1"
}
