{
  "name": "spatial-canvas",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --root .",
    "schemas": "tsx scripts/generate-schemas.ts",
    "fixture": "tsx scripts/generate-fixture.ts",
    "blender:e2e": "tsx scripts/blender-e2e.ts",
    "test:adapter": "python3 -m unittest discover -s adapters/blender/tests -p test_contracts.py -v",
    "test:bindings": "python3 -m unittest discover -s adapters/blender/tests -p test_bindings.py -v",
    "context:validate": "tsx scripts/validate-frozen-context.ts",
    "test:semantics": "python3 -m unittest discover -s adapters/semantics/tests -v",
    "project:ingest": "tsx scripts/ingest-project.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7",
    "three": "^0.184.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
